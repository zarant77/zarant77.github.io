<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>
    <%= site.title %>
  </title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= site.description %>">

  <!-- Canonical -->
  <link rel="canonical" href="<%= contacts.site %>">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= site.ogTitle || (contacts.name + ' — ' + contacts.role) %>">
  <meta property="og:description" content="<%= site.ogDescription || site.description %>">
  <meta property="og:url" content="<%= contacts.site %>">
  <meta property="og:image" content="<%= contacts.site %>assets/img/<%= site.ogImage || 'og-image.jpg' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= site.ogTitle || (contacts.name + ' — ' + contacts.role) %>">
  <meta name="twitter:description" content="<%= site.ogDescription || site.description %>">
  <meta name="twitter:image" content="<%= contacts.site %>assets/img/<%= site.ogImage || 'og-image.jpg' %>">

  <link rel="stylesheet" href="assets/css/styles.css">
</head>

<body>
  <header class="header">
    <div class="container header-inner">
      <div class="header-left">
        <h1 class="name">
          <%= contacts.name %>
        </h1>
        <p class="title">
          <%= contacts.role %>
        </p>
        <p class="subtitle">
          <%= contacts.tagline %>
        </p>

        <div class="header-links">
          <a class="link" href="<%= contacts.github %>" target="_blank" rel="noopener">GitHub</a>
          <span class="sep">•</span>
          <a class="link" href="<%= contacts.linkedin %>" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>

      <div class="header-right">
        <img class="photo" src="assets/img/profile.jpg" alt="<%= contacts.name %> portrait" loading="lazy">
      </div>
    </div>
  </header>

  <main class="container main">

    <section class="section">
      <h2 class="section-title">CV</h2>

      <div class="grid-2">
        <% cv.forEach(item=> { %>
          <article class="card">
            <div class="card-head">
              <h3 class="card-title">
                <%= item.title %>
              </h3>
              <span class="badge">
                <%= item.badge %>
              </span>
            </div>
            <p class="card-text">
              <%= item.text %>
            </p>
            <div class="card-actions">
              <a class="btn" href="<%= item.href %>">Open Web</a>

              <% if (item.pdf) { %>
                <a class="btn" href="<%= item.pdf %>" target="_blank" rel="noopener">
                  Download PDF
                </a>
              <% } %>
            </div>
          </article>
          <% }) %>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">
        <%= site.projectsTitle || "Favorite Projects" %>
      </h2>

      <div class="grid-2">
        <% projects.forEach(p=> { %>
          <article class="card project-card">
            <div class="project-top">
              <img class="project-logo" src="<%= p.logo %>" alt="<%= p.name %> logo" loading="lazy">
              <div class="project-meta">
                <h3 class="card-title">
                  <%= p.name %>
                </h3>
                <p class="muted">
                  <%= p.subtitle %>
                </p>
              </div>
            </div>

            <p class="card-text">
              <%= p.description %>
            </p>

            <div class="card-actions">
              <a class="btn" href="<%= p.demo %>" <%=p.demo.startsWith('http') ? 'target="_blank" rel="noopener"' : ''%>>Demo</a>
              <a class="btn" href="#modal-<%= p.id %>" data-modal-open="<%= p.id %>">Details</a>
            </div>
          </article>
          <% }) %>
      </div>
    </section>

  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span class="muted small">© <span id="y">2026</span>
        <%= contacts.name %>
      </span>
      <div class="footer-links">
        <a class="link" href="<%= contacts.github %>" target="_blank" rel="noopener">GitHub</a>
        <span class="sep">•</span>
        <a class="link" href="<%= contacts.linkedin %>" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </footer>

  <!-- Modals -->
  <% projects.forEach(p=> { %>
    <div class="modal" id="modal-<%= p.id %>" hidden>
      <div class="modal-backdrop" data-modal-close></div>
      <div class="modal-panel">
        <div class="modal-head">
          <h3 class="modal-title">
            <%= p.name %>
          </h3>
          <a class="modal-close" href="#" data-modal-close aria-label="Close">×</a>
        </div>

        <div class="modal-body">
          <p class="muted">
            <%= p.details?.intro || p.description %>
          </p>

          <div class="modal-grid">
            <div>
              <div class="modal-label">Highlights</div>
              <ul class="modal-list">
                <% (p.details?.highlights || []).forEach(x=> { %>
                  <li>
                    <%= x %>
                  </li>
                  <% }) %>
              </ul>
            </div>

            <div>
              <div class="modal-label">Tech</div>
              <ul class="modal-list">
                <% (p.details?.tech || []).forEach(x=> { %>
                  <li>
                    <%= x %>
                  </li>
                  <% }) %>
              </ul>
            </div>
          </div>
        </div>

        <div class="modal-actions">
          <a class="btn" href="<%= p.details?.ctaUrl || p.demo %>" <%=(p.details?.ctaUrl || p.demo).startsWith('http')
            ? 'target="_blank" rel="noopener"' : '' %>>
            <%= p.details?.ctaLabel || "Open" %>
          </a>
          <a class="btn" href="#" data-modal-close>Close</a>
        </div>
      </div>
    </div>
    <% }) %>

      <script src="assets/js/main.js" defer></script>
      <script>
        document.getElementById("y").textContent = new Date().getFullYear();
      </script>
</body>

</html>