<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>
    <%= pageTitle %>
  </title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= metaDescription %>" />
  <link rel="stylesheet" href="../assets/css/cv.css" />
</head>

<body>
  <header class="cv-header">
    <div class="cv-container">
      <div class="cv-top">
        <div class="cv-id">
          <h1 class="cv-name">
            <%= contacts.name %>
          </h1>
          <p class="cv-role">
            <%= contacts.role %>
          </p>
          <p class="cv-tagline">
            <%= titleTagline || contacts.tagline %>
          </p>
        </div>

        <div class="cv-contact">
          <a class="cv-link" href="mailto:<%= contacts.email %>">
            <%= contacts.email %>
          </a>

          <a class="cv-link" href="tel:<%= contacts.phone_e164 %>">
            <%= contacts.phone_display %>
          </a>

          <a class="cv-link" href="<%= contacts.site %>">
            <%= contacts.site.replace('https://','') %>
          </a>

          <% (contacts.links || []).forEach(l=> { %>
            <a class="cv-link" href="<%= l.url %>" target="_blank" rel="noopener">
              <%= l.title %>
            </a>
            <% }) %>
        </div>
      </div>

      <% if (summary) { %>
        <div class="cv-summary">
          <p>
            <%= summary %>
          </p>
        </div>
        <% } %>
    </div>
  </header>

  <main class="cv-container cv-main">
    <% (sections || []).forEach(s=> { %>
      <section class="cv-section">
        <h2 class="cv-h2">
          <%= s.title %>
        </h2>

        <% if (s.type==="text" ) { %>
          <p class="cv-p">
            <%= s.text %>
          </p>
          <% } %>

            <% if (s.type==="bullets" ) { %>
              <ul class="cv-list">
                <% (s.items || []).forEach(it=> { %>
                  <li>
                    <%= it %>
                  </li>
                  <% }) %>
              </ul>
              <% } %>

                <% if (s.type==="jobs" ) { %>
                  <% (s.jobs || []).forEach(j=> { %>
                    <article class="cv-job">
                      <div class="cv-job-head">
                        <div>
                          <h3 class="cv-h3">
                            <%= j.title %>
                          </h3>
                          <p class="cv-meta">
                            <%= j.meta %>
                          </p>

                          <% if (j.stack && j.stack.length) { %>
                            <div class="cv-tags" style="margin-top: 8px;">
                              <% j.stack.forEach(t=> { %>
                                <span class="cv-tag">
                                  <%= t %>
                                </span>
                                <% }) %>
                            </div>
                            <% } %>

                              <% if (j.links && j.links.length) { %>
                                <div style="margin-top: 8px;">
                                  <% j.links.forEach((lnk, idx)=> { %>
                                    <a class="cv-link" href="<%= lnk.href %>" target="_blank" rel="noopener">
                                      <%= lnk.label %>
                                    </a>
                                    <% }) %>
                                </div>
                                <% } %>
                        </div>
                        <div class="cv-dates">
                          <%= j.dates %>
                        </div>
                      </div>

                      <% if (j.text) { %>
                        <p class="cv-p">
                          <%= j.text %>
                        </p>
                        <% } %>

                          <% if (j.bullets) { %>
                            <ul class="cv-list">
                              <% j.bullets.forEach(b=> { %>
                                <li>
                                  <%= b %>
                                </li>
                                <% }) %>
                            </ul>
                            <% } %>

                              <% if (j.blocks) { %>
                                <% j.blocks.forEach(bl=> { %>
                                  <div class="cv-subblock">
                                    <div class="cv-subtitle">
                                      <%= bl.title %>
                                    </div>
                                    <% if (bl.text) { %>
                                      <p class="cv-p">
                                        <%= bl.text %>
                                      </p>
                                      <% } %>
                                        <% if (bl.items) { %>
                                          <ul class="cv-list">
                                            <% bl.items.forEach(x=> { %><li>
                                                <%= x %>
                                              </li>
                                              <% }) %>
                                          </ul>
                                          <% } %>
                                  </div>
                                  <% }) %>
                                    <% } %>
                    </article>
                    <% }) %>
                      <% } %>

                        <% if (s.type==="tags" ) { %>
                          <div class="cv-tags">
                            <% (s.items || []).forEach(t=> { %>
                              <span class="cv-tag">
                                <%= t %>
                              </span>
                              <% }) %>
                          </div>
                          <% } %>

      </section>
      <% }) %>

        <footer class="cv-footer no-print">
          <a class="cv-back" href="../index.html">← Back to landing</a>
          <span class="cv-muted">© <span id="y"></span>
            <%= contacts.name %>
          </span>
        </footer>
  </main>

  <script>
    document.getElementById("y").textContent = new Date().getFullYear();
  </script>
</body>

</html>